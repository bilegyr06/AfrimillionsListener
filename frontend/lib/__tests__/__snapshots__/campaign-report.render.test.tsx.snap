// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`CampaignReport > locks the rendered campaign report markup 1`] = `
"<section class="section"><div class="section-head"><h2>Campaign overview</h2><div class="actions" style="margin:0"><button class="btn btn-secondary btn-sm">Export report</button></div></div><div class="section-body"><table class="kv"><tbody><tr><th>Period</th><td>5 Jan 2026, 10:00 → 19 Jan 2026, 14:30</td></tr><tr><th>Status</th><td>closed</td></tr><tr><th>Attribution</th><td>SMS sent → 21 Jan 2026, 23:59</td></tr><tr><th>Attribution end</th><td>21 Jan 2026, 23:59</td></tr></tbody></table></div><div class="section-body flush"><div class="stat-strip"><div class="stat"><div class="label">Opportunities</div><div class="value">2,480</div></div><div class="stat"><div class="label">Unique customers</div><div class="value">2,311</div></div><div class="stat"><div class="label">Accepted (sent)</div><div class="value">2,093</div></div></div><div class="stat-tier"><div class="stat"><div class="label">Delivered</div><div class="value accent">2,010</div></div><div class="stat"><div class="label">Converted customers</div><div class="value accent">1,184</div></div><div class="stat"><div class="label">Conversion rate</div><div class="value">56.6%</div></div></div></div><div class="section-body flush" style="padding-top:0"><div class="stat-strip"><div class="stat"><div class="label">Pending evaluation</div><div class="value">12</div></div><div class="stat"><div class="label">Not sent to</div><div class="value">387</div></div></div></div><div class="section-body" style="padding-top:0"><table class="kv"><tbody><tr><th>Removed — played before send</th><td>154</td></tr><tr><th>Skipped — limit reached</th><td>89</td></tr><tr><th>Skipped — cooldown active</th><td>41</td></tr><tr><th>Skipped — no valid phone</th><td>63</td></tr><tr><th>SMS failed to send</th><td>22</td></tr><tr><th>Expired with campaign</th><td>18</td></tr></tbody></table><p class="hint" style="margin:10px 20px 0">The funnel moves from login events to distinct customers, then to accepted SMS sends, delivery outcomes, and finally to converted customers. A customer can appear in more than one stage, so the funnel is not a set of strict one-to-one drops.</p></div></section><section class="section"><div class="section-head"><h2>Customer response</h2><span class="muted small">Within the attribution window</span></div><div class="section-body flush"><div class="stat-strip"><div class="stat"><div class="label">Customers contacted</div><div class="value">2,093</div></div><div class="stat"><div class="label">Converted customers</div><div class="value accent">1,184</div></div><div class="stat"><div class="label">Conversion rate</div><div class="value accent">56.6%</div></div></div><div class="stat-tier"><div class="stat"><div class="label">Conversion events</div><div class="value">1,320</div></div><div class="stat"><div class="label">Not converted</div><div class="value">900</div></div><div class="stat"><div class="label">Still awaiting response</div><div class="value">9</div></div></div></div><div class="section-body" style="padding-top:0"><table class="kv"><tbody><tr><th>First qualifying play</th><td>5 Jan 2026, 11:12</td></tr><tr><th>Average time to first play</th><td>24h 0m</td></tr><tr><th>Median time to first play</th><td>14h 30m</td></tr><tr><th>P25 – P75</th><td>5h 0m – 36h 0m</td></tr><tr><th>Min – max</th><td>5m 0s – 144h 0m</td></tr></tbody></table></div><div class="section-body flush" style="padding-top:0"><table class="table"><thead><tr><th>Time to first qualifying play</th><th class="num right">Customers</th></tr></thead><tbody><tr><td class="small">Under 1 hour</td><td class="small num right">320</td></tr><tr><td class="small">1 – 6 hours</td><td class="small num right">400</td></tr><tr><td class="small">6 – 12 hours</td><td class="small num right">200</td></tr><tr><td class="small">12 – 24 hours</td><td class="small num right">150</td></tr><tr><td class="small">24 hours or more</td><td class="small num right">114</td></tr></tbody></table></div></section><section class="section"><div class="section-head"><h2>Player activity</h2><span class="muted small">Qualifying plays by contacted customers</span></div><div class="section-body flush"><div class="stat-strip"><div class="stat"><div class="label">Qualifying plays</div><div class="value">2,105</div></div><div class="stat"><div class="label">Players</div><div class="value accent">1,184</div></div><div class="stat"><div class="label">Repeat players</div><div class="value accent">340</div></div></div><div class="stat-tier"><div class="stat"><div class="label">Converted players</div><div class="value">1,184</div></div><div class="stat"><div class="label">Played before SMS</div><div class="value">96</div></div><div class="stat"><div class="label">Played after window</div><div class="value">37</div></div></div></div><div class="section-body" style="padding-top:0"><table class="kv"><tbody><tr><th>Games played</th><td>3</td></tr><tr><th>Played once</th><td>844</td></tr><tr><th>Average plays per player</th><td>1.78</td></tr><tr><th>Average plays per converted customer</th><td>1.78</td></tr><tr><th>Average plays per contacted customer</th><td>1.01</td></tr><tr><th>Repeat share</th><td>28.7%</td></tr><tr><th>Most plays by one player</th><td>14</td></tr><tr><th>Total play amount</th><td>12,500.50</td></tr><tr><th>Average amount per play</th><td>5.94</td></tr><tr><th>Average amount per converted customer</th><td>10.55</td></tr><tr><th>Average amount per contacted customer</th><td>5.97</td></tr></tbody></table><p class="hint" style="margin:10px 20px 0">A qualifying play lies strictly after the customer’s first Welcome SMS and at or before the attribution window end. Plays before the SMS would have disqualified that customer’s send, so they are listed separately above.</p></div></section><section class="section"><div class="section-head"><h2>Game activity</h2><span class="muted small">Qualifying plays by game</span></div><div class="section-body flush"><table class="table"><thead><tr><th>Game</th><th class="num right">Plays</th><th class="num right">Players</th><th class="num right">Amount</th><th class="num right">Avg. per play</th></tr></thead><tbody><tr><td class="small">Lotto</td><td class="small num right">1,200</td><td class="small num right">900</td><td class="small num right">7,000.00</td><td class="small num right">7.78</td></tr><tr><td class="small">Bingo</td><td class="small num right">655</td><td class="small num right">320</td><td class="small num right">3,850.50</td><td class="small num right">6.03</td></tr><tr><td class="small">Jackpot</td><td class="small num right">250</td><td class="small num right">180</td><td class="small num right">1,650.00</td><td class="small num right">9.17</td></tr></tbody></table></div><div class="section-body" style="padding-top:0"><p class="hint" style="margin:10px 20px 0">Ranked by plays, then by play amount. Customers of a game are the distinct players who qualify in the window, not unique to one game.</p></div></section><section class="section"><div class="section-head"><h2>SMS performance</h2><span class="muted small">Accepted Welcome SMS delivery funnel</span></div><div class="section-body flush"><div class="stat-strip"><div class="stat"><div class="label">Accepted (sent)</div><div class="value">2,093</div></div><div class="stat"><div class="label">Customers contacted</div><div class="value">2,093</div></div><div class="stat"><div class="label">Delivered</div><div class="value accent">2,010</div></div></div><div class="stat-tier-sm"><div class="stat"><div class="label">Failed</div><div class="value">38</div></div><div class="stat"><div class="label">Rejected</div><div class="value">12</div></div><div class="stat"><div class="label">Blocked (DND)</div><div class="value">15</div></div><div class="stat"><div class="label">Deferred</div><div class="value">9</div></div><div class="stat"><div class="label">Expired</div><div class="value">9</div></div></div></div><div class="section-body" style="padding-top:0"><table class="kv"><tbody><tr><th>Delivery rate</th><td>96% of accepted sends</td></tr><tr><th>Awaiting delivery</th><td>0 (4 unmatched to delivery log)</td></tr><tr><th>Avg cost per accepted SMS</th><td>2.00</td></tr></tbody></table><p class="hint" style="margin:10px 20px 0">Deferred means the send was accepted but no provider call was made; those sends never produce a delivery confirmation.</p></div></section><section class="section"><div class="section-head"><h2>Campaign economics</h2><span class="muted small">SMS cost vs attributed play amount</span></div><div class="section-body"><table class="kv"><tbody><tr><th>SMS cost</th><td>4,186.00</td></tr><tr><th>Cost per contacted customer</th><td>2.00</td></tr><tr><th>Cost per conversion</th><td>3.54</td></tr><tr><th>Attributed play amount</th><td>12,500.50</td></tr><tr><th>Play amount per converted customer</th><td>10.55</td></tr><tr><th>Play amount per contacted customer</th><td>5.97</td></tr><tr><th>Activity / cost ratio</th><td>2.99</td></tr></tbody></table><p class="hint" style="margin:10px 20px 0">SMS cost covers this campaign’s own accepted Welcome SMS. A “—” on a per-customer row means there is no customer column to divide over, not a zero cost. Attributed play amount is the qualifying plays inside the attribution window — it is not revenue, and the activity/cost ratio is a descriptive ratio of available data, not ROI.</p></div></section><dialog class="dialog dialog-wide"><div class="dialog-head"><h2>Campaign statistics report</h2><p class="hint" style="margin:4px 0 0">Copy or download for your reports.</p></div><div class="dialog-body"><pre class="snapshot-pre">AFRIMILLIONS LISTENER — CAMPAIGN STATISTICS REPORT
