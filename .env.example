# ============================================================
# TERMII SMS GATEWAY
# Account used to send all notification SMS.
# ============================================================
TERMII_BASE_URL=https://v4.api.termii.com/api
TERMII_API_KEY=your_termii_api_key_here
TERMII_SENDER_ID=AfriMil

# ============================================================
# NOTIFICATION FEATURES
# Comma-separated campaigns to run: "welcome", "inactive", or both.
# Each feature is triggered via the /trigger* endpoints or v2 Campaign Run dispatch.
# ============================================================
ENABLED_FEATURES=welcome,inactive

# --- Welcome-back (post-sign-in campaign) ---------------------
# A sign-in becomes eligible once WELCOME_EVAL_DELAY_HOURS have elapsed,
# provided the user played no game during that wait period.
# Each qualifying sign-in may trigger at most one Welcome SMS per active campaign.
# The campaign window is operator-driven: start/close via /campaign/start and
# /campaign/close. Response attribution is measured against Sales_*.csv plays
# between the SMS send and the campaign close.
WELCOME_EVAL_DELAY_HOURS=1     # wait after sign-in before evaluating eligibility
WELCOME_MAX_MESSAGES=3         # per-user cap on Welcome SMS (0 = unlimited)
WELCOME_POST_LIMIT_SUPPRESS=true  # true = stop sending once the cap is hit
WELCOME_MESSAGE=Hi {first_name}, great to see you back! We missed you at AfriMillions.

# --- Inactivity reminder ---------------------------------------
INACTIVE_MESSAGE=Hi {first_name}, we miss you! Log in to AfriMillions to keep playing.

# ============================================================
# NOTIFICATION BEHAVIOUR & THROTTLING
# Thresholds, cooldowns, caps and concurrency for the send engine.
# ============================================================
INACTIVITY_HOURS=48        # inactivity threshold (inactive feature + auto-reset)
COOLDOWN_HOURS=24          # min hours between messages to the same user
MAX_MESSAGES=0             # max inactivity messages per user overall (0 = unlimited)
MAX_CONCURRENCY=50         # parallel SMS sends per batch
SMS_TIMEOUT=30             # per-request timeout (seconds) for the SMS gateway

# ============================================================
# CYCLE SCHEDULING
# START_TIME/END_TIME gate SMS sending.
# CYCLE_END_HOUR is the absolute hour a cycle must not run past.
# ============================================================
START_TIME=12:00
END_TIME=18:00
CYCLE_END_HOUR=20

# ============================================================
# DATA INPUTS
# Where source CSVs live and the expected file-name patterns.
# CSV patterns are matched on the LATEST file in DATA_FOLDER.
# Sales_*.csv (game plays) is required by the welcome feature for eligibility
# evaluation and response attribution.
# ============================================================
DATA_FOLDER=data
LOGIN_FILE_PATTERN=Login_*.csv
REGISTRATION_FILE_PATTERN=Registrations_*.csv
SALES_FILE_PATTERN=Sales_*.csv

# ============================================================
# DATABASE
# SQLite file used for notification state, dedupe, SMS log & stats.
# ============================================================
DB_PATH=database/notified_users.db